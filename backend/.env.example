# Copy to backend/.env (git-ignored) and fill in.
# Shared secret the userscript sends as X-Ingest-Secret. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DUO_INGEST_SECRET=change-me-to-a-long-random-string

# SQLite file (relative to backend/). Default: data/companion.db
DUO_DB_PATH=data/companion.db

# Bind address. Keep 127.0.0.1 when exposing via `tailscale serve` (see README).
DUO_HOST=127.0.0.1
DUO_PORT=8000
